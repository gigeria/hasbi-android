<?xml version="1.0" encoding="utf-8"?>
<!-- Backup rules — Hasbi uses local Room DB, no cloud sync by default -->
<full-backup-content>
    <!-- Room database — auto-backup via Android Auto Backup (small) -->
    <include domain="database" path="hasbi.db" />
    <include domain="database" path="hasbi.db-journal" />
    <include domain="database" path="hasbi.db-wal" />
    <include domain="database" path="hasbi.db-shm" />

    <!-- DataStore preferences -->
    <include domain="file" path="datastore/settings.preferences_pb" />

    <!-- User-initiated encrypted backups (SAF chosen locations) are excluded — they live where user placed them -->
</full-backup-content>
