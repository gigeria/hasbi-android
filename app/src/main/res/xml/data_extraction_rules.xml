<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ data extraction rules — finer control over what gets backed up -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="hasbi.db" />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="hasbi.db" />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
